# Supabase Auth
# Copy to .env and fill with your Supabase project credentials.
# Get these from your Supabase project dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Studio contact — the address customers are told to write to.
# Shown in the contact section and used as the honest fallback when the
# contact form or the newsletter cannot store anything.
VITE_CONTACT_EMAIL=
# WhatsApp number in international format, digits only (+62…). Optional.
VITE_CONTACT_WHATSAPP=
# Where the studio is / ships from. Defaults to "Indonesia" when empty.
VITE_BRAND_ORIGIN=

# Social channels (optional — blank hides the link)
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=

# Payments — manual bank transfer. All three must be set before the method is
# offered at checkout; leave them blank and the store says so instead of
# showing a fake account. Never commit a real account number.
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_ACCOUNT_NAME=

# Payments — Midtrans. Set to the deployed `create-payment` Edge Function URL
# (e.g. https://<project>.supabase.co/functions/v1/create-payment) to enable
# Midtrans Snap checkout. Leave blank to hide the method entirely.
VITE_PAYMENT_ENDPOINT=

# Cloudflare Turnstile (anti-spam). Site key is public (rendered in browser);
# secret key goes in Supabase Edge Function env (TURNSTILE_SECRET_KEY), never here.
VITE_TURNSTILE_SITE_KEY=

# Social channels — full URLs. A blank value hides that channel entirely.
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_X=

# Legal pages — full URLs. The footer legal row only renders when all three
# are set. Leave blank until the pages are actually published.
VITE_POLICY_PRIVACY_URL=
VITE_POLICY_TERMS_URL=
VITE_POLICY_COOKIES_URL=
